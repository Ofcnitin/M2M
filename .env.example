# ── Public (exposed to the browser; safe to publish) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CDN_URL=https://media.example.com
NEXT_PUBLIC_IMAGE_TRANSFORMS=false

# ── Server-only (NEVER prefix these with NEXT_PUBLIC_) ───────────────────────
SUPABASE_SERVICE_KEY=
ANALYTICS_SALT=

# Cloudflare R2 (server-only credentials; never shipped to clients)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=m2m-media
# Private bucket for restricted (mature) media. If unset, restricted objects use the
# `restricted/` prefix inside R2_BUCKET — in that case that prefix must NOT be served
# by the public CDN domain. See README "Production deployment checklist".
R2_PRIVATE_BUCKET=

# Age access (v9) uses self-declaration — date of birth on the profile plus a
# recorded acceptance of the current age policy version (see src/lib/age-policy.ts
# and migration 0023). There is no age-assurance provider to configure.

# Rate limiting (server-only, optional). In-memory baseline limits for the
# authenticated /api/track and /api/progress routes; per-instance only — a
# multi-instance production deployment needs a shared store. See docs/SECURITY.md.
RATE_LIMIT_TRACK_LIMIT=60
RATE_LIMIT_TRACK_WINDOW_MS=60000
RATE_LIMIT_PROGRESS_LIMIT=120
RATE_LIMIT_PROGRESS_WINDOW_MS=60000

# Worker (workers/processor/wrangler.toml + `wrangler secret put`):
#   SUPABASE_URL (var), SUPABASE_SERVICE_KEY (secret), MEDIA binding (public bucket),
#   MEDIA_PRIVATE binding (optional private bucket), queues m2m-uploads + m2m-uploads-dlq,
#   crons "*/5 * * * *" (scheduled publishing + cleanup) and "0 3 * * *" (orphan scan).
